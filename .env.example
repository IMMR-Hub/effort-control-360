# Plantilla de configuración de EFFORT Control 360.
#
# Copiá este archivo a `.env` y completá los valores. El `.env` NO se sube a
# git (está en .gitignore); este `.env.example` sí, para que se sepa qué hace
# falta sin exponer ningún secreto.
#
# El servidor valida todo esto al arrancar y NO levanta si algo falta o es
# inseguro. Es a propósito: es preferible que no arranque a que arranque con
# la cookie sin proteger y nadie se entere hasta que haya un incidente.


# --- Entorno ----------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Puerto en el que escucha la API.
PORT=3000

# fatal | error | warn | info | debug | trace
NIVEL_LOG=info


# --- Base de datos ----------------------------------------------------------

# Cadena de conexión a PostgreSQL.
#
# En Supabase: Project Settings -> Database -> Connection string -> URI.
# Se ve así (reemplazá TU-PASSWORD por la contraseña del proyecto):
#   postgresql://postgres:TU-PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=


# --- Seguridad --------------------------------------------------------------

# Secreto para firmar cookies. Mínimo 32 caracteres.
#
# Generá uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# No reutilices el de desarrollo en producción, y no lo compartas por chat ni
# por correo: quien lo tenga puede falsificar cookies de sesión.
SECRETO_COOKIES=

# Origen exacto desde el que se sirve la interfaz. Sin barra final, sin comodines.
#   desarrollo: http://localhost:5173
#   producción: https://effort360.disaak.com
#
# En producción debe ser https: sobre http la cookie de sesión viaja en claro.
ORIGEN_PERMITIDO=http://localhost:5173

# Cloudflare Turnstile (opcional).
# Si se deja vacío, el acceso queda protegido solo por el límite de intentos.
TURNSTILE_SECRET=


# --- OneDrive / Microsoft Graph (todavía no implementado) -------------------
#
# Se completan cuando EFFORT cree la cuenta de sistema y registre la aplicación
# en Azure AD. Ver docs/DISCREPANCIAS.md, punto 6.

# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# ONEDRIVE_CARPETA_RAIZ_ID=
# ONEDRIVE_CARPETA_RESPALDO_ID=
